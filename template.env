CKAN_SITE_URL=http://127.0.0.1:5000
CKAN_PORT=5000
POSTGRES_PASSWORD=readwritepw  # pragma: allowlist secret
CKAN_MAX_UPLOAD_SIZE_MB=1000
CKAN_ADMIN_PASSWORD=administrator  # pragma: allowlist secret
BEAKER_SESSION_SECRET=changeme-use-a-long-random-string  # pragma: allowlist secret

DOI_PREFIX=
DOI_ACCOUNT_NAME=
DOI_ACCOUNT_PWD=
DOI_TEST_MODE=true

CKAN_OAUTH2_AUTHORIZATION_ENDPOINT=https://auth.dataporten.no/oauth/authorization
CKAN_OAUTH2_TOKEN_ENDPOINT=https://auth.dataporten.no/oauth/token
CKAN_OAUTH2_CLIENT_ID=
CKAN_OAUTH2_CLIENT_SECRET=

# Sentry DSN (overrides the default baked into wsgi.py when set)
#SENTRY_DSN=

PLAUSIBLE_DOWNLOAD_TRACKING=false

# DataStore / DataPusher
# Empty values use the compose defaults: datapusher reachable at
# http://datapusher:8800/, CKAN at http://ckan:5000/, and an API token
# minted at boot for an auto-created `datapusher_bot` sysadmin. For prod,
# pre-mint a token (`ckan user token add datapusher_bot`) and set
# CKAN_DATAPUSHER_API_TOKEN + CKAN_DATAPUSHER_CALLBACK_URL accordingly.
CKAN_DATAPUSHER_URL=
CKAN_DATAPUSHER_CALLBACK_URL=
CKAN_DATAPUSHER_API_TOKEN=

# Docker socket path (for rootless Docker, e.g. /run/user/1000/docker.sock)
#DOCKER_SOCK=/var/run/docker.sock
